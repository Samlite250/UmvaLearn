# Configure in Vercel project settings; never commit real credentials.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_APP_URL=https://your-project.vercel.app
VITE_API_URL=

# The website runs English/French translation and transcription on-device and
# uses device speech voices, so these provider keys are optional for those tools.
# Kinyarwanda translation uses MyMemory through /api/translate-free without a key
# or payment method. Its daily free quota applies; no paid fallback is used.
# The following settings apply to direct API clients and optional explanations.
# Hosted API translation: openai, mymemory, or auto (OpenAI with MyMemory fallback).
# local requires a separately hosted persistent model service via LOCAL_AI_URL.
TRANSLATION_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1
ELEVENLABS_API_KEY=
PINDO_ACCESS_TOKEN=
