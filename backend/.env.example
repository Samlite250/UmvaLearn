# Keep provider keys on the backend only. Never use VITE_ for these keys.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1
ELEVENLABS_API_KEY=
# Optional authenticated Pindo access. Blank uses documented public rate-limited endpoints.
PINDO_ACCESS_TOKEN=
PORT=3002

# auto falls back to MyMemory if OpenAI is missing or has no credits.
# Options: local, auto, openai, mymemory. On Vercel use a hosted provider;
# local requires a separately hosted model service and reachable LOCAL_AI_URL.
TRANSLATION_PROVIDER=local

# Local CPU model service (no API credits)
LOCAL_AI_URL=http://127.0.0.1:3003
